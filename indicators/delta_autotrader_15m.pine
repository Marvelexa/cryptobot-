//@version=5
indicator("Delta AutoTrader 15M Institutional Strategy", overlay=true)

// ==========================================
// 1. Anti-Chop Shield (Choppiness Index)
// ==========================================
chop_len = input.int(14, "Chop Period")
ci = 100 * math.log10(math.sum(ta.tr(true), chop_len) / (ta.highest(high, chop_len) - ta.lowest(low, chop_len))) / math.log10(chop_len)
is_chop_active = ci > 58.0

// ==========================================
// 2. Multi-Asset Technical Indicators
// ==========================================
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema80 = ta.ema(close, 80)
ema100 = ta.ema(close, 100)
atr14 = ta.atr(14)

[bb_mid, bb_upper, bb_lower] = ta.bb(close, 20, 2.0)
rsi5 = ta.rsi(close, 5)

wave_fast = ta.ema(close, 9)
wave_slow = ta.ema(close, 21)
wave_val = wave_fast - wave_slow
wave_sig = ta.ema(wave_val, 7)

// ==========================================
// 3. Institutional Candle Patterns (Bidirectional: BUY & SELL)
// ==========================================
candle_range = high - low
candle_body = math.abs(close - open)
body_pct = (candle_body / (candle_range > 0 ? candle_range : 0.0001)) * 100
is_green = close > open

// Bullish Patterns
is_bull_power_bar = is_green and body_pct >= 45.0
is_hammer = (math.min(open, close) - low) >= 2 * candle_body and (high - math.max(open, close)) <= 0.25 * candle_body
is_bull_engulfing = is_green and (close[1] < open[1]) and close > open[1] and open < close[1] and body_pct >= 40.0
is_institutional_bull = is_bull_power_bar or is_hammer or is_bull_engulfing

// Bearish Patterns
is_bear_power_bar = not is_green and body_pct >= 45.0
is_shooting_star = (high - math.max(open, close)) >= 2 * candle_body and (math.min(open, close) - low) <= 0.25 * candle_body
is_bear_engulfing = not is_green and (close[1] > open[1]) and close < open[1] and open > close[1] and body_pct >= 40.0
is_institutional_bear = is_bear_power_bar or is_shooting_star or is_bear_engulfing

// Reversal signals
buy_signal = is_institutional_bull and not is_chop_active and close > ema100 and ta.crossover(wave_val, wave_sig)
sell_signal = is_institutional_bear and not is_chop_active and close < ema100 and ta.crossunder(wave_val, wave_sig)

// Plots
plot(ema100, "100 EMA (Trend Guard)", color=color.blue, linewidth=2)
plot(bb_upper, "BB Upper", color=color.new(color.gray, 50))
plot(bb_lower, "BB Lower", color=color.new(color.purple, 40), linewidth=2)

plotshape(buy_signal, title="BUY Signal", style=shape.labelup, location=location.belowbar, color=color.green, size=size.normal, text="BUY", textcolor=color.black)
plotshape(sell_signal, title="SELL Signal", style=shape.labeldown, location=location.abovebar, color=color.red, size=size.normal, text="SELL", textcolor=color.white)

// Background highlighting for Chop Freeze
bgcolor(is_chop_active ? color.new(color.red, 92) : na, title="Anti-Chop Shield Freeze")
